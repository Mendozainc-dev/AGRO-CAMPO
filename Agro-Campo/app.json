{
  "expo": {
    "name": "Agro-Campo",
    "slug": "Agro-Campo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/LogoAgroCampo.png",
    "scheme": "agrocampo",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/LogoAgroCampo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/LogoAgroCampo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AgroCampo necesita usar la cámara para fotografiar una inspección.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/LogoAgroCampo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
