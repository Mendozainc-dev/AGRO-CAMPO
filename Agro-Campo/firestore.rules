rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function canReadFieldCatalog() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['tecnico', 'admin'];
    }

    function canCreateCatalogRecords() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function boundedNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function inspectionDetails(crop, details) {
      return details is map && (
        (crop == 'fresa'
          && details.keys().hasOnly(['gradosBrix'])
          && boundedNumber(details.get('gradosBrix', 0), 0, 100))
        || (crop == 'sorgo'
          && details.keys().hasOnly(['humedadGrano'])
          && boundedNumber(details.get('humedadGrano', 0), 0, 100))
        || (crop == 'hortalizas'
          && details.keys().hasOnly(['sistemaRiego', 'phSuelo'])
          && details.get('sistemaRiego', '') is string
          && details.get('sistemaRiego', '').size() <= 100
          && boundedNumber(details.get('phSuelo', 0), 0, 14))
      );
    }

    function inspectionMatchesPlot(data) {
      return validText(data.parcelaId, 128)
        && data.parcelaId.matches('[^/]+')
        && inspectionDetails(
          get(/databases/$(database)/documents/parcelas/$(data.parcelaId)).data.cultivo,
          data.detalles
        );
    }

    match /inspecciones/{inspeccionId} {
      allow read: if canReadFieldCatalog();
      allow create: if canReadFieldCatalog()
        && request.resource.data.keys().hasOnly([
          'parcelaId', 'fecha', 'tecnicoId', 'tecnicoNombre', 'latitud', 'longitud',
          'fotos', 'plagas', 'estadoRiego', 'etapaFenologica', 'observaciones', 'detalles'
        ])
        && request.resource.data.tecnicoId == request.auth.uid
        && request.resource.data.tecnicoNombre == get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.nombre
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && boundedNumber(request.resource.data.latitud, -90, 90)
        && boundedNumber(request.resource.data.longitud, -180, 180)
        && request.resource.data.fotos == []
        && request.resource.data.plagas is string && request.resource.data.plagas.size() <= 300
        && request.resource.data.estadoRiego is string && request.resource.data.estadoRiego.size() <= 100
        && request.resource.data.etapaFenologica is string && request.resource.data.etapaFenologica.size() <= 100
        && request.resource.data.observaciones is string && request.resource.data.observaciones.size() <= 1000
        && inspectionMatchesPlot(request.resource.data);
    }

    match /aplicaciones/{aplicacionId} {
      allow read: if canReadFieldCatalog();
      allow create: if canReadFieldCatalog()
        && request.resource.data.keys().hasOnly(['parcelaId', 'producto', 'dosis', 'fecha', 'tecnicoId'])
        && request.resource.data.tecnicoId == request.auth.uid
        && validText(request.resource.data.parcelaId, 128)
        && request.resource.data.parcelaId.matches('[^/]+')
        && exists(/databases/$(database)/documents/parcelas/$(request.resource.data.parcelaId))
        && validText(request.resource.data.producto, 150)
        && validText(request.resource.data.dosis, 100)
        && request.resource.data.fecha is string
        && request.resource.data.fecha.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    // cosechas: parcelaId, volumen (toneladas), comprador y fecha de recolección.
    function validHarvest(data) {
      return data.keys().hasOnly(['parcelaId', 'volumen', 'comprador', 'fecha'])
        && validText(data.parcelaId, 128)
        && data.parcelaId.matches('[^/]+')
        && exists(/databases/$(database)/documents/parcelas/$(data.parcelaId))
        && data.volumen is number
        && data.volumen > 0 && data.volumen < math.pow(10, 308)
        && validText(data.comprador, 150)
        && data.fecha is string
        && data.fecha.matches('[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    match /cosechas/{cosechaId} {
      allow read: if canReadFieldCatalog();
      allow create: if canReadFieldCatalog() && validHarvest(request.resource.data);
    }

    match /productores/{productorId} {
      allow read: if canReadFieldCatalog();
      allow create: if canCreateCatalogRecords()
        && request.resource.data.keys().hasOnly(['nombre', 'comunidad', 'telefono', 'createdAt'])
        && validText(request.resource.data.nombre, 150)
        && validText(request.resource.data.comunidad, 100)
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() == 24;
    }

    match /parcelas/{parcelaId} {
      allow read: if canReadFieldCatalog();
      allow create: if canCreateCatalogRecords()
        && request.resource.data.keys().hasOnly(['productorId', 'cultivo', 'superficie', 'ubicacion'])
        && validText(request.resource.data.productorId, 128)
        && request.resource.data.productorId.matches('[^/]+')
        && exists(/databases/$(database)/documents/productores/$(request.resource.data.productorId))
        && request.resource.data.cultivo in ['fresa', 'sorgo', 'hortalizas']
        && request.resource.data.superficie is number
        && request.resource.data.superficie > 0
        && request.resource.data.superficie < math.pow(10, 308)
        && validText(request.resource.data.ubicacion, 200);
    }

    match /usuarios/{uid} {
      allow get: if isVerifiedOwner(uid);

      allow create: if isVerifiedOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'rol'])
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.rol == 'tecnico';
    }
  }
}
